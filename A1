# PROJECTILE MOTION GAME


angle = 45.0
velocity = 50.0

g = 9.8
scale = 3.0
dt = 0.05

posX = 50.0
posY = 0.0

vx = 0.0
vy = 0.0

isFired = False
hasShot = False

score = 0
attempts = 0

target = None
resultMessage = ""

btnFireX = 20
btnFireY = 90
btnW = 80
btnH = 30

btnLockAngleX = 110
btnLockAngleY = 90
btnLockAngleW = 120
btnLockAngleH = 30

btnLockVelX = 240
btnLockVelY = 90
btnLockVelW = 120
btnLockVelH = 30

btnCenterW = 160
btnCenterH = 40

pathHistory = []

def setup():
    size(850, 600)
    newTarget()

def draw():
    background(220, 240, 255)

    drawEnvironment()
    drawTarget()
    drawUI()

    if isFired:
        updatePhysics()
        checkCollision()
    elif not hasShot:
        drawAimLine()

    drawPath()
    drawBullet()
    
    if resultMessage == "MISSED!":
        drawCenterButton("RESET TRY", color(220, 50, 50))
    elif resultMessage == "HIT! +100":
        drawCenterButton("NEXT TARGET", color(40, 180, 80))

def drawEnvironment():
    noStroke()
    fill(135, 206, 235)
    rect(0, 0, width, height - 50)
    fill(200, 230, 255)
    rect(0, height / 2, width, (height / 2) - 50)

    fill(255, 255, 255, 220)
    ellipse(180, 100, 70, 40)
    ellipse(210, 90, 50, 35)
    ellipse(150, 105, 50, 30)

    ellipse(600, 120, 90, 45)
    ellipse(640, 110, 60, 40)
    ellipse(560, 125, 60, 35)

    fill(130, 160, 190)
    triangle(100, height - 50, 250, 280, 400, height - 50)
    triangle(300, height - 50, 480, 220, 650, height - 50)
    
    fill(100, 135, 170)
    triangle(500, height - 50, 680, 250, 850, height - 50)

    fill(120, 85, 50)
    rect(0, height - 50, width, 50)
    fill(80, 180, 70)
    rect(0, height - 50, width, 12)

    drawCannon()

def drawCannon():
    pushMatrix()
    translate(50, height - 50)

    pushMatrix()
    rotate(radians(-angle))

    fill(50)
    rect(0, -12, 55, 24, 4)
    fill(90)
    rect(5, -9, 45, 18, 2)

    fill(30)
    rect(50, -15, 8, 30, 2)
    popMatrix()

    fill(100, 60, 20)
    triangle(-25, 0, 15, 0, -5, -20)

    fill(140, 85, 35)
    ellipse(0, 0, 36, 36)
    fill(180, 120, 60)
    ellipse(0, 0, 24, 24)
    fill(60)
    ellipse(0, 0, 8, 8)

    popMatrix()

def autoAimLockAngle():
    global velocity, angle

    if hasShot:
        return

    X = (target.x - 50) / scale
    Y = ((height - 50) - target.y) / scale

    rad = radians(angle)
    denom = 2 * (cos(rad) ** 2) * (X * tan(rad) - Y)

    if denom <= 0:
        minAngleRad = atan2(Y, X) + radians(10)
        angle = degrees(minAngleRad)
        angle = constrain(angle, 5, 85)
        rad = radians(angle)
        denom = 2 * (cos(rad) ** 2) * (X * tan(rad) - Y)

    if denom > 0:
        velocity = sqrt((g * X * X) / denom)
        fireCannon()

def autoAimLockVel():
    global velocity, angle

    if hasShot:
        return

    X = (target.x - 50) / scale
    Y = ((height - 50) - target.y) / scale

    v2 = velocity * velocity
    disc = (v2 * v2) - g * (g * X * X + 2 * Y * v2)

    if disc < 0:
        minV = sqrt(g * (Y + sqrt(X * X + Y * Y)))
        velocity = ceil(minV) + 1
        v2 = velocity * velocity
        disc = (v2 * v2) - g * (g * X * X + 2 * Y * v2)

    if disc >= 0:
        tanTheta = (v2 - sqrt(disc)) / (g * X)
        angle = degrees(atan(tanTheta))
        angle = constrain(angle, 1, 89)
        fireCannon()

def fireCannon():
    global vx, vy, isFired, hasShot, attempts, resultMessage

    if hasShot:
        return

    rad = radians(angle)
    vx = velocity * cos(rad)
    vy = -velocity * sin(rad)

    isFired = True
    hasShot = True
    attempts += 1
    resultMessage = ""

def resetCannon():
    global posX, posY, vx, vy, isFired, hasShot, pathHistory, resultMessage

    posX = 50.0
    posY = float(height - 50)

    vx = 0.0
    vy = 0.0

    isFired = False
    hasShot = False
    pathHistory = []
    resultMessage = ""

def newTarget():
    global target
    target = PVector(random(400, 750), random(200, 500))
    resetCannon()

def updatePhysics():
    global posX, posY, vx, vy, isFired, resultMessage

    vy += g * dt

    posX += vx * dt * scale
    posY += vy * dt * scale

    pathHistory.append(PVector(posX, posY))

    if posY >= height - 50 or posX >= width:
        if posY >= height - 50:
            posY = height - 50

        vx = 0
        vy = 0
        isFired = False

        if resultMessage != "HIT! +100":
            resultMessage = "MISSED!"

def checkCollision():
    global score, isFired, vx, vy, resultMessage

    d = dist(posX, posY, target.x, target.y)

    if d <= 25:
        score += 100
        vx = 0
        vy = 0
        isFired = False
        resultMessage = "HIT! +100"

def drawPath():
    fill(100)
    noStroke()
    for p in pathHistory:
        ellipse(p.x, p.y, 4, 4)

def drawAimLine():
    stroke(255, 0, 0)
    strokeWeight(2)
    rad = radians(angle)
    line(50, height - 50, 50 + cos(rad) * 50, (height - 50) - sin(rad) * 50)
    noStroke()

def drawBullet():
    fill(50)
    ellipse(posX, posY, 16, 16)

def drawTarget():
    fill(255, 50, 50)
    ellipse(target.x, target.y, 30, 30)

    fill(255)
    ellipse(target.x, target.y, 15, 15)

    targetDx_m = (target.x - 50) / scale
    targetDy_m = ((height - 50) - target.y) / scale

    fill(0)
    textSize(12)
    textAlign(CENTER)
    text("Target: ({:.1f}m, {:.1f}m)".format(targetDx_m, targetDy_m), target.x, target.y - 25)
    textAlign(LEFT)

def drawUI():
    fill(0)
    textSize(14)
    text("Angle (UP/DOWN): {:.1f} deg".format(angle), 20, 30)
    text("Velocity (LEFT/RIGHT): {:.1f} m/s".format(velocity), 20, 50)

    fill(150, 0, 150)
    text("g = {} m/s^2".format(g), 20, 75)

    fill(0, 100, 200)
    textSize(16)
    text("SCORE: {}".format(score), 480, 30)
    text("ATTEMPTS: {}".format(attempts), 480, 50)

    targetDx_m = (target.x - 50) / scale
    targetDy_m = ((height - 50) - target.y) / scale

    textSize(14)
    fill(0)
    text("Target Offset (X, Y): ({:.1f} m, {:.1f} m)".format(targetDx_m, targetDy_m), 480, 75)

    fill(0, 150, 255)
    rect(btnFireX, btnFireY, btnW, btnH, 5)
    fill(255)
    textSize(14)
    text("FIRE", btnFireX + 22, btnFireY + 20)

    fill(150, 50, 200)
    rect(btnLockAngleX, btnLockAngleY, btnLockAngleW, btnLockAngleH, 5)
    fill(255)
    text("AIM (LOCK DEG)", btnLockAngleX + 10, btnLockAngleY + 20)

    fill(200, 100, 0)
    rect(btnLockVelX, btnLockVelY, btnLockVelW, btnLockVelH, 5)
    fill(255)
    text("AIM (LOCK VEL)", btnLockVelX + 10, btnLockVelY + 20)

    if resultMessage != "":
        textAlign(CENTER, CENTER)
        textSize(40)

        if resultMessage == "MISSED!":
            fill(220, 50, 50)
        else:
            fill(0, 150, 0)

        text(resultMessage, width / 2, height / 2 - 30)
        textAlign(LEFT)

def drawCenterButton(labelText, btnColor):
    rectMode(CENTER)
    fill(btnColor)
    rect(width / 2, height / 2 + 30, btnCenterW, btnCenterH, 8)

    fill(255)
    textSize(16)
    textAlign(CENTER, CENTER)
    text(labelText, width / 2, height / 2 + 30)

    rectMode(CORNER)
    textAlign(LEFT)

def keyPressed():
    global angle, velocity

    if not hasShot:
        if keyCode == UP and angle < 90:
            angle += 2
        elif keyCode == DOWN and angle > 0:
            angle -= 2
        elif keyCode == RIGHT:
            velocity += 2
        elif keyCode == LEFT and velocity > 2:
            velocity -= 2

        elif key == ' ':
            fireCannon()
        elif key in ['1', 'a', 'A']:
            autoAimLockAngle()
        elif key in ['2', 'v', 'V']:
            autoAimLockVel()

    if key in ['r', 'R']:
        resetCannon()

def mousePressed():
    if resultMessage != "":
        if (width / 2 - btnCenterW / 2 <= mouseX <= width / 2 + btnCenterW / 2 and
            height / 2 + 30 - btnCenterH / 2 <= mouseY <= height / 2 + 30 + btnCenterH / 2):
            if resultMessage == "MISSED!":
                resetCannon()
            elif resultMessage == "HIT! +100":
                newTarget()
            return

    if (btnFireX <= mouseX <= btnFireX + btnW and
        btnFireY <= mouseY <= btnFireY + btnH):
        fireCannon()
        return

    if (btnLockAngleX <= mouseX <= btnLockAngleX + btnLockAngleW and
        btnLockAngleY <= mouseY <= btnLockAngleY + btnLockAngleH):
        autoAimLockAngle()
        return

    if (btnLockVelX <= mouseX <= btnLockVelX + btnLockVelW and
        btnLockVelY <= mouseY <= btnLockVelY + btnLockVelH):
        autoAimLockVel()
        return
